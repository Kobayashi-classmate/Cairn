# SPDX-License-Identifier: AGPL-3.0-only
[Unit]
Description=Cairn root helper socket
Documentation=https://github.com/Kobayashi-classmate/Cairn

[Socket]
ListenStream=/run/cairn/helper.sock
SocketUser=root
SocketGroup=cairn
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
