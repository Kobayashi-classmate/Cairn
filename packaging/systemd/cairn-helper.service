# The only privileged part of Cairn. Started on demand through
# cairn-helper.socket; it never listens on the network.
[Unit]
Description=Cairn root helper
Documentation=https://github.com/Kobayashi-classmate/Cairn
Requires=cairn-helper.socket
After=cairn-helper.socket

[Service]
Type=simple
ExecStart=/usr/lib/cairn/cairn-helper
Restart=on-failure
RestartSec=2
# No PrivateTmp: the file manager works in the helper, and with the whole
# disk opened it must show the real /tmp and /var/tmp. The helper's own temp
# files use random names (os.CreateTemp), which is safe in a shared /tmp.
#
# Everything the helper starts inherits the protections below, which is why
# the package manager is not started here: with /usr/lib/modules hidden a
# kernel package cannot be unpacked, and a maintainer script that rebuilds
# the initramfs leaves one without modules. Every apt-get or dnf run that
# changes something gets a transient unit of its own without them,
# cairn-pkg.service ("cairn-helper run-pkg").
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
