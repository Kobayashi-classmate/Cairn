# Unprivileged web panel. It holds no capabilities and can write only to its
# own data directory; privileged work goes through cairn-helper.
[Unit]
Description=Cairn web panel
Documentation=https://github.com/Kobayashi-classmate/Cairn
Wants=network-online.target cairn-helper.socket
After=network-online.target cairn-helper.socket

[Service]
Type=simple
User=cairn
Group=cairn
ExecStart=/usr/bin/cairn-web
Restart=on-failure
RestartSec=2
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ReadWritePaths=/var/lib/cairn
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
